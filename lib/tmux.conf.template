# Generated by `retro-console setup` from lib/tmux.conf.template; edits are overwritten.

set -g default-terminal "tmux-256color"
set -g escape-time 10
set -g history-limit 50000
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Closing the terminal window destroys the session, stopping every tab's command
set -g destroy-unattached on
setw -g automatic-rename off
setw -g allow-rename off

# Highlight tabs with new output
setw -g monitor-activity on
set -g visual-activity off

set -g status-style "bg=black,fg=@FG@"
set -g status-left ""
set -g status-right "%H:%M "
setw -g window-status-format " #I:#W "
setw -g window-status-current-format " #I:#W "
setw -g window-status-current-style "bg=@FG@,fg=black,bold"
setw -g window-status-activity-style "fg=black,bg=yellow"
set -g message-style "bg=@FG@,fg=black"
set -g pane-border-style "fg=@FG@"
set -g pane-active-border-style "fg=@FG@"
